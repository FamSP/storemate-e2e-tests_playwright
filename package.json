{
  "name": "storemate-e2e",
  "version": "1.0.0",
  "description": "Playwright E2E tests for StoreMate (US-03 product list, US-04 search, US-05 product detail)",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:guest": "playwright test --project=guest",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "dotenv": "^16.4.5"
  }
}
